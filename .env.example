# Copy to .env and adjust. Never commit .env.

# ---- Mongo (dataspace read model) --------------------------------------
# Atlas SRV connection string. Required — the API reads every analytic
# endpoint from Mongo and only touches S3 during a sync.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name (default: ondas_dataspace)
# MONGODB_DB=ondas_dataspace

# ---- Auth --------------------------------------------------------------
# JWT signing secret. Required in production.
PORTAL_JWT_SECRET=change-me-to-a-long-random-string
# Token TTL (default 8h)
# PORTAL_JWT_EXPIRES_IN=8h
# Set to true once every legacy portal connector has been migrated to a Mongo
# user, to switch off the plaintext connector-file fallback in POST /v1/auth/login.
# DISABLE_LEGACY_CONNECTOR_LOGIN=true
# Legacy connector file, only read by that fallback.
# PORTAL_CONNECTORS_FILE=config/portal-connectors.local.json

# ---- Seed (npm run seed) -----------------------------------------------
# First admin account. The password is generated and printed once if unset.
# SEED_ADMIN_EMAIL=admin@universalplastic.io
# SEED_ADMIN_PASSWORD=
# Email domain given to the seeded participant users.
# SEED_EMAIL_DOMAIN=participants.universalplastic.io

# ---- Data space S3 bucket ----------------------------------------------
DATASPACE_S3_BUCKET=universalplastic-sedia
DATASPACE_S3_REGION=eu-central-1
DATASPACE_S3_ROOT_PREFIX=public/
# POST /v1/sync/scan lists the bucket when the runtime has s3:ListBucket.
# Without it the scan falls back to the inventory bundled in s3-reader.ts and
# says so in the run warnings. Objects are always read over public HTTPS.

# ---- Swagger / proxy ---------------------------------------------------
# Public URL path prefix (documentation links only; Nest still serves /v1, /docs).
# PUBLIC_API_BASE_PATH=/api
# PUBLIC_API_DISPLAY_URL=https://ondas.universalplastic.io/api
